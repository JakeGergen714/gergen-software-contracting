{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build backend with Maven",
			"type": "shell",
			"command": "mvn -q -f backend/pom.xml clean package",
			"problemMatcher": [
				"$maven"
			],
			"group": "build"
		},
		{
			"label": "Typecheck portal",
			"type": "shell",
			"command": "npm -s --prefix portal run build",
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Typecheck website",
			"type": "shell",
			"command": "npm -s --prefix website run build",
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		},
		{
			"label": "Start compose watch",
			"type": "shell",
			"command": "docker compose watch",
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Docker: Up (Build All)",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"--build"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Docker: Up (Build Backend)",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"--build",
				"api"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Docker: Up (Build Frontend)",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"--build",
				"web"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}
