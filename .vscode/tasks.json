{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build backend with Maven",
			"type": "shell",
			"command": "mvn -q -f backend/pom.xml clean package",
			"problemMatcher": [
				"$maven"
			],
			"group": "build"
		},
		{
			"label": "Typecheck frontend",
			"type": "shell",
			"command": "npm -s --prefix frontend run build",
